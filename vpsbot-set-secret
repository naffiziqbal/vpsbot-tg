#!/bin/bash
# Set the Telegram bot token + chat ID for vpsbot without echoing the token.
# Usage: sudo vpsbot-set-secret
set -euo pipefail
ENV=/etc/vpsbot/env
TE_ENV=/var/www/personal/thoughtExpense/thought-expense-server/.env
[ "$(id -u)" = 0 ] || { echo "run with sudo"; exit 1; }

read -rsp "Bot token from @BotFather (hidden): " token; echo
[[ "$token" =~ ^[0-9]{6,12}:[A-Za-z0-9_-]{30,}$ ]] || { echo "that doesn't look like a bot token"; exit 1; }

bot=$(TOKEN="$token" python3 -I -c '
import json, os, urllib.request
url = "https://api.telegram.org/bot" + os.environ["TOKEN"] + "/getMe"
r = json.load(urllib.request.urlopen(url, timeout=15))
print(r["result"]["username"])') || { echo "Telegram rejected the token"; exit 1; }
echo "✓ token valid: @$bot"

default=$(sed -n 's/^TELEGRAM_ALERT_CHAT_ID=//p' "$TE_ENV" 2>/dev/null | tail -1 | tr -d "\"'\r" || true)
read -rp "Your chat ID${default:+ [Enter = same chat as ThoughtExpense alerts]}: " chat
chat=${chat:-$default}
[[ "$chat" =~ ^-?[0-9]+$ ]] || { echo "chat ID must be a number"; exit 1; }

umask 027
printf 'VPSBOT_TOKEN=%s\nVPSBOT_CHAT_ID=%s\nVPSBOT_DAILY_HOUR=9\n' "$token" "$chat" > "$ENV"
unset token
chown root:vpsbot "$ENV"; chmod 640 "$ENV"
echo "✓ saved $ENV"

systemctl enable --now vpsbot >/dev/null 2>&1; systemctl restart vpsbot
sleep 3
systemctl is-active --quiet vpsbot && echo "✓ vpsbot running. Open https://t.me/$bot, press Start, then send /health" \
  || { echo "vpsbot failed to start:"; journalctl -u vpsbot -n 15 --no-pager; exit 1; }
