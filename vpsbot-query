    return json.dumps({h: s for h, s in sites().items() if not s["elsewhere"]})


def cmd_baseline():
    if os.environ.get("SUDO_USER") == "vpsbot":
        return "Refused: the baseline can only be reset by an admin on the server."
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    data = {"ts": time.time(), "files": watched_files(), "ports": sorted(listening())}
    with open(BASELINE, "w") as f:
        json.dump(data, f)
    os.chmod(BASELINE, 0o600)
    return f"Baseline saved: {len(data['files'])} files, {len(data['ports'])} listening ports."


