[Unit]
Description=Telegram VPS monitor bot (read-only)
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=vpsbot
Group=vpsbot
EnvironmentFile=/etc/vpsbot/env
EnvironmentFile=-/etc/vpsbot/config
ExecStart=/usr/bin/python3 -I /opt/vpsbot/bot.py
Restart=always
RestartSec=15
ProtectSystem=full
# metrics history for /graph, forecasts and /week: /var/lib/vpsbot/history.db
StateDirectory=vpsbot
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
